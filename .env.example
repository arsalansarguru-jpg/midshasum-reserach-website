# Required to deliver contact-form submissions in production.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Required for durable production rate limiting (Upstash Redis REST).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: canonical production URL used by deployment tooling.
NEXT_PUBLIC_SITE_URL=https://midshasumresearch.com
